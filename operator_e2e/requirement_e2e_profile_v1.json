{
  "format": "xlsx",
  "source_timezone": "UTC",
  "source_mode": "authoritative_snapshot",
  "worksheet": {
    "name": null,
    "header_row": 1,
    "first_data_row": 2,
    "trim_headers": true,
    "case_sensitive": false
  },
  "mapping": {
    "external_item_id": {"source": "external_item_id", "required": true, "type": "text", "match": "normalized", "transforms": ["trim", "empty_to_null"]},
    "title": {"source": "title", "required": true, "type": "text", "match": "normalized", "transforms": ["trim", "normalize_whitespace", "empty_to_null"]},
    "prompt_content": {"source": "prompt_content", "required": true, "type": "text", "match": "normalized", "transforms": ["trim", "empty_to_null"]},
    "source_updated_at": {"source": "source_updated_at", "required": true, "type": "datetime", "match": "normalized", "transforms": ["empty_to_null", "to_datetime"]},
    "source_created_at": {"source": "source_created_at", "required": true, "type": "datetime", "match": "normalized", "transforms": ["empty_to_null", "to_datetime"]},
    "expires_at": {"source": "expires_at", "required": false, "type": "datetime", "match": "normalized", "transforms": ["empty_to_null", "to_datetime"]}
  }
}
