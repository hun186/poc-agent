# ============================================================
# SRA Operator E2E local configuration
#
# Copy this file to:
#   operator_e2e/e2e.env.local
#
# e2e.env.local is ignored by Git and must NEVER be committed.
# ============================================================

# ------------------------------------------------------------
# Common SRA API endpoint
# ------------------------------------------------------------

SRA_E2E_BASE_URL=http://127.0.0.1:9002

# Legacy compatibility only. Phase 0 prefers SRA_E2E_BASE_URL
# and falls back to this older name.
# SRA_E2E_API_BASE=http://127.0.0.1:9002

# ============================================================
# Optional — Phase 0 API routing / authorization evidence
#
# Used by test_phase0_api_routing_evidence.py only.
# ============================================================

SRA_E2E_OPENWEBUI_KEY=<managed-openwebui-service-key>
SRA_E2E_READ_ONLY_KEY=<managed-read-only-service-key>
SRA_E2E_REPORT_KEY=<managed-report-service-key>

# The Phase 0 Service Keys above must NOT automatically be reused as
# Requirement Editor authentication. In particular, do not configure
# SRA_E2E_EDITOR_TOKEN = SRA_E2E_REPORT_KEY unless an operator has
# independently provisioned that one credential with exactly the scopes
# needed for Requirement control-plane fixture creation/import and Schedule
# approval/enablement.

# ============================================================
# Requirement Automatic Operator E2E authentication
#
# These credentials are logically separate from the Phase 0 Service Keys.
# Configure EXACTLY ONE authentication mode.
# ============================================================

# Mode A — username/password
SRA_E2E_EDITOR_USERNAME=<authorized-editor-or-superuser>
SRA_E2E_EDITOR_PASSWORD=<managed-secret>

# Mode B — bearer token. If using token mode, remove/comment Mode A.
# SRA_E2E_EDITOR_TOKEN=<authorized-editor-token>

# ============================================================
# Requirement Automatic Operator E2E runtime
# ============================================================

SRA_E2E_MODEL=SRA-Structured Retrieval Agent
SRA_E2E_REQUIREMENT_ARTIFACT_ROOT=<absolute-production-requirement-artifact-root>

# SHA-256 of operator_e2e/input/requirement_e2e_3items.xlsx
SRA_E2E_EXPECTED_SOURCE_SHA=2d50bed20a3e697020107ece218e7c001580e1df03adc1c30f8060c4e9118d03

# Supplied EXTERNALLY by completed post-merge source review.
# Do NOT copy a historical SHA or self-attest with $(git rev-parse HEAD).
SRA_E2E_EXPECTED_RUNTIME_SHA=<reviewed-hosted-main-sha-from-acceptance-handoff>

# ============================================================
# Optional Requirement E2E paths / timeout overrides
# ============================================================

# SRA_E2E_OUTPUT_DIR=operator_e2e/output/requirement_e2e
# SRA_E2E_API_LOG_PATH=SRA-API_output.txt
# SRA_E2E_SCHEDULE_LOG_PATH=SRA-ScheduleWorker_output.txt
# SRA_E2E_HANDOFF_LOG_PATH=SRA-HandoffWorker_output.txt

# Normally leave timeout overrides unset.
# SRA_E2E_ANCHOR_LEAD_SECONDS=120
# SRA_E2E_ALLOWED_ANCHOR_WINDOW_SECONDS=300
# SRA_E2E_AUTO_CLAIM_TIMEOUT_SECONDS=210
# SRA_E2E_HANDOFF_TIMEOUT_SECONDS=120
# SRA_E2E_REMOTE_TIMEOUT_SECONDS=1800
# SRA_E2E_RECONCILE_TIMEOUT_SECONDS=180
