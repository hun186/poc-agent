# ============================================
#  Elasticsearch 基本設定
# ============================================
# ES 主機位址（通常為 http://localhost:9200）
ES_URL=http://localhost:9200

# 預設索引，可依需求切換
# ES_INDEX=news_test
# ES_INDEX=mil_reports-01


# ============================================
#  API 服務設定
# ============================================
# FastAPI 對外 API 基底路徑（請改成你的主機位址）
PUBLIC_API_BASE=http://127.0.0.1:8000


# ============================================
#  模型服務（LLM）設定
# ============================================
# LLM API base URL，例如本地 Ollama（預設 11434）
MODEL_BASE_URL=http://127.0.0.1:11434

# 主題分類／風格學習 LLM
TOPIC_LLM_URL=http://127.0.0.1:11434
TOPIC_LLM_MODEL=gpt-oss:120b-32k

# 是否開啟 LLM 呼叫除錯（0=關閉，1=開啟）
DEBUG_CALL_LLM=1

# 主模型 ID（依你的 Ollama 模型名稱調整）
MODEL_ID=gpt-oss:120b-32k
# MODEL_ID=gpt-oss:120b-64k
# MODEL_ID=qwen3:32b-32k


# ============================================
#  OpenAI / 相容 API 設定（必要時才填）
# ============================================
# OPENAI_API_KEY=your_api_key_here


# ============================================
#  代理人 / 對話記憶
# ============================================
HISTORY_MAX_CHARS=25000


# ============================================
#  本服務埠號
# ============================================
SERVICE_PORT=8081


# ============================================
#  同義詞設定檔（請保持相對路徑）
# ============================================
PLATFORM_SYNONYMS_PATH=config/platform_synonyms.json
