#############################################
# SRA Agent - Release Sample Env (.env.example)
# 說明：
# 1) 這是「發布用樣本檔」，請勿放入真實密碼/Token
# 2) 實際部署請複製為 .env 並填入正確值
#############################################

########################
# Elasticsearch 設定
########################
# ES_URL 可用 http 或 https
# 例：http://localhost:9200
# 例：https://es.example.com:9200
ES_URL=https://<ES_HOST>:<ES_PORT>

# 若你使用 Elasticsearch Service Token（可選）
# ES_SERVICE_TOKEN=<YOUR_SERVICE_TOKEN>

# 若使用帳密登入
ES_USERNAME=<ES_USERNAME>
ES_PASSWORD=<ES_PASSWORD>

# 預設索引（可填單一 index；若程式支援多 index 再自行擴充）
ES_INDEX=news_test
# ES_INDEX=mil_reports-01

# 連線逾時秒數
ES_TIMEOUT=30

# 代理人參考文本：具前後文脈絡的全文或精煉詳文，與零碎 evidence snippets 區隔。
# 可指向 nested dot path；未設定時維持既有 rawInfo.content。
# TXT→ES / SQL→ES 會保留 rawInfo.content 並初始化此欄位；agent/API 讀取此欄位。
SRA_REFERENCE_TEXT_FIELD=rawInfo.content


########################
# SRA 模型代理人 API
########################
# 對外提供的代理人 API Base URL
PUBLIC_API_BASE=http://<SRA_API_HOST>:<SRA_API_PORT>


########################
# SRA API 安全 / OpenWebUI 整合
########################
# APP_ENV 未設定時預設為 dev。正式環境請設為 production；production 會啟用較嚴格的安全檢查。
# APP_ENV=production

# SRA API 伺服器端「Signed URL 簽章密鑰」。
# 用途：簽署/驗證 citation、文件全文與 Word 等限時瀏覽器下載連結；OpenWebUI 不會拿這把密鑰呼叫 API。
# 正式環境必須固定且至少 32 bytes；部署時由管理者產生一次後安全保存，不要每次啟動重新產生。
# 可產生範例：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 不可與 OpenWebUI 使用的 sra_sk_... Service Key 共用。
# SRA_SIGNED_URL_SECRET=<GENERATE_AND_STORE_A_STABLE_SECRET_AT_LEAST_32_BYTES>

# Service Key 儲存檔「路徑」，不是 API Key。
# 未設定時預設為目前工作目錄的 .sra_service_keys.json。
# 單機 Windows 部署若 API 與 CLI 都從專案根目錄執行，可直接使用預設值；
# production / container 可改成受備份保護的 persistent path。
# API 與 create/list/revoke Service Key CLI 都會載入專案 .env 並共用此 store 路徑。
# SRA_SERVICE_KEYS_FILE=.sra_service_keys.json
# Windows 範例：SRA_SERVICE_KEYS_FILE=D:/shared/TopicClassification/poc-agent/.sra_service_keys.json
# Linux 範例：SRA_SERVICE_KEYS_FILE=/var/lib/sra/service-keys.json

# OpenWebUI 真正使用的 Service Key 不要直接寫死在此樣本檔。
# 請在 SRA API 主機執行以下 CLI 建立，完整 sra_sk_... 只會顯示一次：
# python -m api.security.cli create-service-key --name openwebui-production --scope model:read --scope model:invoke
# 然後將該 sra_sk_... 填入 OpenWebUI 的 OpenAI-compatible connection「API Key」欄位。

# 跨來源瀏覽器呼叫白名單；production 建議明確指定 OpenWebUI Origin。
# 多個 origin 以逗號分隔，請勿使用 * 搭配 credential。
# CORS_ALLOWED_ORIGINS=http://<OPENWEBUI_HOST>:<PORT>


########################
# Ollama / LLM 服務設定
########################
# Ollama Base URL（常見：11434）
MODEL_BASE_URL=http://<OLLAMA_HOST>:11434

# 主題/抽取類任務用 LLM（若你的程式會獨立呼叫）
TOPIC_LLM_URL=http://<OLLAMA_HOST>:11434
TOPIC_LLM_MODEL=gpt-oss:120b-32k
# TOPIC_LLM_MODEL=gpt-oss:latest-32k

# 預設主模型
MODEL_ID=gpt-oss:120b-32k
# MODEL_ID=gpt-oss:120b-64k
# MODEL_ID=qwen3:32b-32k

# 可選：各子代理人獨立模型（需要時才開）
# ROUTER_MODEL_ID=gpt-oss:120b-32k
# ROUTER_LLM_TIMEOUT=120
# Router 只使用 bounded head/tail view 判斷模式；不會截斷實際執行或 Word 匯出內容。
# 當輪訊息預設上限 6000 字元（最低 512），每筆歷史訊息預設 1500（最低 256）。
# ROUTER_CURRENT_MAX_CHARS=6000
# ROUTER_HISTORY_MAX_CHARS=1500
# 關鍵字提取器另用 bounded temporary view；完整查詢仍傳給同義詞與 ES 流程。
# KEYWORD_EXTRACTION_MAX_CHARS=6000
# DATA_AGENT_MODEL_ID=gpt-oss:120b-32k
# REPORT_MODEL_ID=gpt-oss:120b-32k
# STYLE_MODEL_ID=gpt-oss:120b-32k
# PURE_LLM 直接生成與 REPORT 是不同執行路徑，兩者 timeout 不共用。
# PURE_LLM_TIMEOUT=900
# REPORT_LLM_TIMEOUT=900

# 若你的程式需要 OPENAI_API_KEY 才能啟動（即使不會真的用）
# OPENAI_API_KEY=<DUMMY_OR_REAL_KEY>


########################
# 內容與歷史控制
########################
# Session / History 字元上限（避免記憶體與 payload 爆量）
HISTORY_MAX_CHARS=25000


########################
# 服務 Port（若你的 API 服務會讀這個）
########################
# SERVICE_PORT=8081


########################
# Query Refiner（報告模式檢索提問優化）
########################
# 0=關閉、1=啟用
QUERY_REFINER_REPORT_ENABLED=1

# 可選：Refiner 使用的模型、逾時
# QUERY_REFINER_REPORT_MODEL_ID=gpt-oss:120b-32k
# QUERY_REFINER_REPORT_TIMEOUT=60

# 可選：是否讓 refiner 看上下文（拼裝字串）
QUERY_REFINER_REPORT_USE_CONTEXT=1
QUERY_REFINER_REPORT_MAX_CONTEXT_CHARS=4000


########################
# 同義詞設定
########################
# 使用者自訂同義詞目錄（支援多檔讀入）
MANUAL_SYNONYMS_DIR=config/synonyms


########################
# 風格仿寫（Docx Style）
########################
DOCX_STYLE_REF_MAX_DOCS=8
DOCX_STYLE_REF_MAX_CHARS=4000


########################
# 文件跟進代理人（Doc Followup）
########################
DOC_FOLLOWUP_MAX_TOTAL_CHARS=26000
DOC_FOLLOWUP_MAX_DOCS=5


########################
# 偵錯 / Profiling
########################
# 0=關閉、1=啟用
DEBUG_PROFILING=0
DEBUG_CALL_LLM=0

########################
# API Store（若你的專案有 session 記錄落地）
########################
# API_STORE_ENABLED=0
# API_STORE_MAX_MSGS=200
# API_STORE_MIN_INTERVAL=2
# SESSION_MAX_TURNS=40

########################
# Vercel Preview / Mock Runtime
########################
# auto=在非 production 的 Vercel / 唯讀環境優先嘗試真實 ES，失敗後啟用 mock ES + mock Excel→SQL
# force=強制使用 mock；never=停用 mock
SRA_VERCEL_MOCK_MODE=auto
# 公開 preview 建議設定長隨機 secret；設定後 mock preview login 需輸入此 secret
# 範例值只供本地/文件示意，公開部署請在 Vercel Project Settings 換成隨機值
SRA_VERCEL_PREVIEW_LOGIN_SECRET=replace-with-random-preview-secret

# Vercel preview 建議關閉落地 API store，避免 serverless 唯讀 / 非持久檔案系統問題
API_STORE_ENABLED=0

########################
# Standalone Batch Scheduler (keep keys in runtime secret configuration)
########################
SRA_API_BASE=http://127.0.0.1:9002
SRA_BATCH_SERVICE_KEY=
SRA_BATCH_DB_PATH=.batch_scheduler/scheduler.sqlite3
SRA_BATCH_OUTPUT_ROOT=.batch_scheduler/output
SRA_BATCH_POLL_SECONDS=2
SRA_BATCH_HTTP_CONNECT_TIMEOUT=10
SRA_BATCH_HTTP_READ_TIMEOUT=30
SRA_BATCH_MAX_RETRIES=3
# Operator-only Phase 0 smoke harness credentials (never commit values)
SRA_SMOKE_OPENWEBUI_KEY=
SRA_SMOKE_READONLY_KEY=
SRA_SMOKE_REPORT_KEY=

########################
# Requirement import pipeline (Phase 1B)
########################
REQUIREMENT_PIPELINE_ENABLED=false
# Canonical direct DB keys live in this ignored registry file. The legacy variables below
# remain available when its named connection uses *_env keys (recommended for managed secrets).
REQUIREMENT_SQL_REGISTRY_FILE=config/requirements/sql_registry.json
REQUIREMENT_CONTROL_DB_CONNECTION=requirement_control
REQUIREMENT_DB_SCHEMA=sra_requirement
REQUIREMENT_SOURCE_ALLOWED_ROOTS=./data/requirement_sources
REQUIREMENT_CONTROL_DB_DRIVER=ODBC Driver 18 for SQL Server
REQUIREMENT_CONTROL_DB_SERVER=
REQUIREMENT_CONTROL_DB_DATABASE=
REQUIREMENT_CONTROL_DB_TRUSTED_CONNECTION=true
REQUIREMENT_CONTROL_DB_USER=
REQUIREMENT_CONTROL_DB_PASSWORD=

# Optional deployment-owned path overrides. The launcher securely generates the
# Requirement Handoff credential/configuration under .sra_runtime by default.
SRA_DEPLOYMENT_STATE_DIR=.sra_runtime
SRA_SERVICE_KEYS_FILE=.sra_service_keys.json


########################
# SRAF ARC 自適應檢索控制器（統一設定區）
########################
# 安全預設：全部 off；shadow = 僅觀察，不採用新的排序、收緊、放寬或語意判斷。
# 主開關：off 強制關閉全部 ARC；shadow 預設開啟六項本地觀察。
# 未設定主開關則維持舊版個別設定行為；on 尚未支援，會安全關閉。
SRAF_ARC_MODE=off
# 本地六項若未設定，將跟隨主開關；需要停用某項才取消註解並填 off。
# 若舊 .env 已有個別 off 設定，改為 shadow 或移除該行才能使用預設組合。
# 開啟順序與依賴：docs/operations/sraf_arc_env.md
# 僅複製需要的區塊到自己的 .env，更新既有同名設定，不覆蓋私有帳密。
# 改完須依目前部署方式重新啟動相關 API / Worker，才會套用到新程序。

# A3/A4/A5/A6：低風險本地觀察（不額外呼叫 ES 或 LLM）
# SRAF_ARC_GROUP_FREQUENCY=off
# SRAF_ARC_RANK=off
# SRAF_ARC_TIGHTEN=off
# SRAF_ARC_RELAX=off

# A2/A7：可增加 LLM 呼叫；原有 TOPIC_LLM_URL / MODEL_BASE_URL 等設定適用。
# LLM_PRIORITY=shadow 會在 A2/A7 之間分配同輪額外呼叫，非全部強制執行。
# 不送 Evidence 正文，但會送原始問題及語意群組；先確認既有模型資料政策。
SRAF_ARC_BILINGUAL=off
SRAF_ARC_STRATEGY=off
SRAF_ARC_LLM_PRIORITY=off

# A3b/A4：普通報告 ES 原生文件頻率及加權排序觀察（額外 ES 呼叫）
# RANK_NATIVE 依賴 ES_FREQUENCY；VERIFIED_INDEX 必須為已核對 mapping/analyzer、
# 授權範圍及負載的單一具體索引。空白表示未核准，不要盲目填 news_test。
SRAF_ARC_ES_FREQUENCY=off
SRAF_ARC_ES_FREQUENCY_VERIFIED_INDEX=
SRAF_ARC_RANK_NATIVE=off

# A3b/A4：深度報告同 PIT 統計及排序（另需受信任 Worker 的獨立統計政策）
SRAF_ARC_DEEP_FREQUENCY=off
SRAF_ARC_DEEP_FREQUENCY_VERIFIED_INDEX=
SRAF_ARC_RANK_DEEP=off

# A8：普通報告本地語意複查樣本準備（不會傳輸正文）
# VERIFIED_INDEX 與下方專用傳輸共用；即使設 shadow，普通報告仍未接入模型傳輸。
SRAF_ARC_REVIEW_SCOPE=off

# A8：專用模型語意複查傳輸（目前僅受信任深度執行路徑，另需文件級 egress 授權）
# 不可僅靠 env 核准資料傳輸。預設不批准；完成私有驗收及真實授權政策前保持關閉。
SRAF_ARC_REVIEW=off
SRAF_ARC_REVIEW_DEEP=off
SRAF_ARC_REVIEW_EGRESS=off
SRAF_ARC_REVIEW_VERIFIED_INDEX=
# 只接受 HTTPS 完整 /api/chat 路徑；不可使用 URL 內帳密、query、fragment。
# SRAF_ARC_REVIEW_ENDPOINT=https://<APPROVED_MODEL_HOST>:<PORT>/api/chat
SRAF_ARC_REVIEW_ENDPOINT=
SRAF_ARC_REVIEW_MODEL=
# 空白使用系統信任 CA；私人 CA 填受保護的本機 CA 檔案路徑，不能關閉 TLS 驗證。
SRAF_ARC_REVIEW_CA_FILE=

# A9：資源觀察；非完整端到端網路呼叫/Token/Word 生成總量。
# SRAF_ARC_ORDINARY_RESOURCE_METRICS=off
# SRAF_ARC_DEEP_RESOURCE_METRICS=off
SRAF_ARC_REVIEW_RESOURCE_METRICS=off

# A3 局部群組頻率每切片預算：正整數可調低，不能超過下列硬上限。
# CHARS 是掃描文字字元數，不是 LLM tokens，也不會改變正式 Evidence 上限。
# SRAF_ARC_GROUP_FREQUENCY_MAX_HITS=128
# SRAF_ARC_GROUP_FREQUENCY_MAX_ROWS=256
# SRAF_ARC_GROUP_FREQUENCY_MAX_ROWS_PER_HIT=8
# SRAF_ARC_GROUP_FREQUENCY_MAX_CHARS=131072
# SRAF_ARC_GROUP_FREQUENCY_MAX_ROW_CHARS=4096
# SRAF_ARC_GROUP_FREQUENCY_MAX_GROUPS=16
# SRAF_ARC_GROUP_FREQUENCY_MAX_TERMS=64
# SRAF_ARC_GROUP_FREQUENCY_MAX_TERM_CHARS=160

# A9：獨立人工操作的唯讀 ES 樣本擷取 CLI，非 API / Worker 自動執行。
# 命令明確 --run 才會擷取；使用者需另行提供最小權限帳號、嚴格 CA/IP SAN。
# 不使用正式服務的帳密作為預設；不可提交真實密碼或私有位址。
# SRAF_ARC_CAPTURE_ES_URL=https://<PRIVATE_ES_IP>:<PORT>
SRAF_ARC_CAPTURE_ES_URL=
SRAF_ARC_CAPTURE_ES_USERNAME=
SRAF_ARC_CAPTURE_ES_PASSWORD=
SRAF_ARC_CAPTURE_ES_CA_FILE=

# 既有獨立的低量 topic-adaptive（非上述 A6 ARC shadow）。
# shadow 只觀察；on 確實可能改變正式 Evidence。不要把它當作整套 ARC 總開關。
# 此舊功能在未完成 A/B 驗收前保持原本設定或 off。
# SRAF_TOPIC_MATCH_ADAPTIVE=off
