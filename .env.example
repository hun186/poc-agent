#############################################
# SRA Agent - Release Sample Env (.env.example)
# 說明：
# 1) 這是「發布用樣本檔」，請勿放入真實密碼/Token
# 2) 實際部署請複製為 .env 並填入正確值
#############################################

########################
# Elasticsearch 設定
########################
# ES_URL 可用 http 或 https
# 例：http://localhost:9200
# 例：https://es.example.com:9200
ES_URL=https://<ES_HOST>:<ES_PORT>

# 若你使用 Elasticsearch Service Token（可選）
# ES_SERVICE_TOKEN=<YOUR_SERVICE_TOKEN>

# 若使用帳密登入
ES_USERNAME=<ES_USERNAME>
ES_PASSWORD=<ES_PASSWORD>

# 預設索引（可填單一 index；若程式支援多 index 再自行擴充）
ES_INDEX=news_test
# ES_INDEX=mil_reports-01

# 連線逾時秒數
ES_TIMEOUT=30


########################
# SRA 模型代理人 API
########################
# 對外提供的代理人 API Base URL
PUBLIC_API_BASE=http://<SRA_API_HOST>:<SRA_API_PORT>


########################
# Ollama / LLM 服務設定
########################
# Ollama Base URL（常見：11434）
MODEL_BASE_URL=http://<OLLAMA_HOST>:11434

# 主題/抽取類任務用 LLM（若你的程式會獨立呼叫）
TOPIC_LLM_URL=http://<OLLAMA_HOST>:11434
TOPIC_LLM_MODEL=gpt-oss:120b-32k
# TOPIC_LLM_MODEL=gpt-oss:latest-32k

# 預設主模型
MODEL_ID=gpt-oss:120b-32k
# MODEL_ID=gpt-oss:120b-64k
# MODEL_ID=qwen3:32b-32k

# 可選：各子代理人獨立模型（需要時才開）
# ROUTER_MODEL_ID=gpt-oss:120b-32k
# Router 只使用 bounded head/tail view 判斷模式；不會截斷實際執行或 Word 匯出內容。
# 當輪訊息預設上限 6000 字元（最低 512），每筆歷史訊息預設 1500（最低 256）。
# ROUTER_CURRENT_MAX_CHARS=6000
# ROUTER_HISTORY_MAX_CHARS=1500
# 關鍵字提取器另用 bounded temporary view；完整查詢仍傳給同義詞與 ES 流程。
# KEYWORD_EXTRACTION_MAX_CHARS=6000
# DATA_AGENT_MODEL_ID=gpt-oss:120b-32k
# REPORT_MODEL_ID=gpt-oss:120b-32k
# STYLE_MODEL_ID=gpt-oss:120b-32k
# PURE_LLM 直接生成與 REPORT 是不同執行路徑，兩者 timeout 不共用。
# PURE_LLM_TIMEOUT=900
# REPORT_LLM_TIMEOUT=900

# 若你的程式需要 OPENAI_API_KEY 才能啟動（即使不會真的用）
# OPENAI_API_KEY=<DUMMY_OR_REAL_KEY>


########################
# 內容與歷史控制
########################
# Session / History 字元上限（避免記憶體與 payload 爆量）
HISTORY_MAX_CHARS=25000


########################
# 服務 Port（若你的 API 服務會讀這個）
########################
# SERVICE_PORT=8081


########################
# Query Refiner（報告模式檢索提問優化）
########################
# 0=關閉、1=啟用
QUERY_REFINER_REPORT_ENABLED=1

# 可選：Refiner 使用的模型、逾時
# QUERY_REFINER_REPORT_MODEL_ID=gpt-oss:120b-32k
# QUERY_REFINER_REPORT_TIMEOUT=40

# 可選：是否讓 refiner 看上下文（拼裝字串）
QUERY_REFINER_REPORT_USE_CONTEXT=1
QUERY_REFINER_REPORT_MAX_CONTEXT_CHARS=4000


########################
# 同義詞設定
########################
# 使用者自訂同義詞目錄（支援多檔讀入）
MANUAL_SYNONYMS_DIR=config/synonyms


########################
# 風格仿寫（Docx Style）
########################
DOCX_STYLE_REF_MAX_DOCS=8
DOCX_STYLE_REF_MAX_CHARS=4000


########################
# 文件跟進代理人（Doc Followup）
########################
DOC_FOLLOWUP_MAX_TOTAL_CHARS=26000
DOC_FOLLOWUP_MAX_DOCS=5


########################
# 偵錯 / Profiling
########################
# 0=關閉、1=啟用
DEBUG_PROFILING=0
DEBUG_CALL_LLM=0


########################
# API Store（若你的專案有 session 記錄落地）
########################
# API_STORE_ENABLED=0
# API_STORE_MAX_MSGS=200
# API_STORE_MIN_INTERVAL=2
# SESSION_MAX_TURNS=40

########################
# Vercel Preview / Mock Runtime
########################
# auto=在非 production 的 Vercel / 唯讀環境優先嘗試真實 ES，失敗後啟用 mock ES + mock Excel→SQL
# force=強制使用 mock；never=停用 mock
SRA_VERCEL_MOCK_MODE=auto
# 公開 preview 建議設定長隨機 secret；設定後 mock preview login 需輸入此 secret
# 範例值只供本地/文件示意，公開部署請在 Vercel Project Settings 換成隨機值
SRA_VERCEL_PREVIEW_LOGIN_SECRET=replace-with-random-preview-secret

# Vercel preview 建議關閉落地 API store，避免 serverless 唯讀 / 非持久檔案系統問題
API_STORE_ENABLED=0
