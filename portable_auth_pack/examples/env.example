# Copy to .env or export these variables before starting the target FastAPI app.
# Use a long random value in real deployments. Example generation:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-bytes

# Optional: set to production/prod to enforce a non-empty AUTH_SECRET of at least 32 bytes.
AUTH_ENV=dev

# Optional: keep auth data outside the repository.
AUTH_USERS_FILE=./runtime/.auth_users.json
AUTH_LOGIN_AUDIT_FILE=./runtime/.auth_users.login_audit.json
AUTH_BOOTSTRAP_SUPERUSERS_FILE=./config/auth/bootstrap_superusers.json

# Optional: token lifetime in seconds. Default is 43200 (12 hours).
AUTH_TOKEN_TTL_SECONDS=43200

# Optional: Vercel preview helper. auto enables the temporary reader login on
# non-production Vercel environments.
# Use never/disabled in real deployments that should not expose mock preview login.
AUTH_VERCEL_MOCK_MODE=auto
# Optional: when set, preview login requires X-Auth-Preview-Login-Secret.
# Example placeholder only; use a random value in public preview deployments.
AUTH_VERCEL_PREVIEW_LOGIN_SECRET=replace-with-random-portable-preview-secret
